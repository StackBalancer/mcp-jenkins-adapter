# ============================================
# Jenkins Configuration
# ============================================
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASS=change_this_secure_password_123!
JENKINS_MCP_USER=mcp-user
JENKINS_MCP_PASS=change_this_mcp_password_456!

# ============================================
# AI LLM Configuration
# ============================================
# Options: "openai" or "claude"
LLM_PROVIDER=claude
# Optional: override the default model for your chosen provider
# Claude options:  claude-sonnet, claude-haiku, claude-opus
# OpenAI options:  gpt-4o, gpt-4o-mini
LLM_MODEL=

# ============================================
# OpenAI Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ============================================
# Claude Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_ANTHROPIC_API_KEY_here

# ============================================
# MCP Server Configuration
# ============================================
# Optional: Override MCP server URL
# Default: http://mcp-server:8081/sse (internal Docker network)
# MCP_SERVER_URL=http://localhost:8081/sse

# ============================================
# Jenkins API Configuration
# ============================================
# Optional: Override Jenkins URL
# Default: http://jenkins:8080/jenkins (internal Docker network)
# JENKINS_URL=http://localhost:8082/jenkins
